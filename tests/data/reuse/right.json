{
  "$comment": "Acceptance for walk-corner-right 0.1.0 on hallway-corner 0.2.0, reverse traversal from livingproof-worlds v1.4.0. See world-source.json for released provenance. Acceptance and trial policy are identical to walk-corner-left 0.2.0; robot support and success must be established separately.",
  "format": "livingproof-scenario-parameters/0.1",
  "scenario": {
    "id": "walk-corner-right",
    "revision": "0.1.0"
  },
  "world": {
    "id": "hallway-corner",
    "content_version": "0.2.0"
  },
  "places": {
    "start": "spawn-north",
    "exit": "end-west",
    "route": "route-reverse",
    "through": [
      "corner"
    ]
  },
  "parameters": {
    "command_speed": {
      "value": 0.5,
      "unit": "m/s"
    },
    "wall_clearance": {
      "by": "robot_class",
      "unit": "m",
      "values": {
        "humanoid": 0.05,
        "quadruped": 0.1
      }
    },
    "trials": {
      "count": 1,
      "identical": true,
      "retries": false,
      "trial_policy": "all-required-v1",
      "run_rule": "every-trial-passes"
    }
  },
  "inputs": {
    "route_length": {
      "kind": "quantity",
      "unit": "m",
      "source": "world",
      "rule": "route-length-from-start-to-exit",
      "text": "Distance along the route polyline from the point on it nearest the start pose to the route's last point, the exit reference point."
    },
    "clear_width": {
      "kind": "quantity",
      "unit": "m",
      "source": "world",
      "path": "dimensions.clear_width",
      "text": "Distance between the inner faces of the walls."
    },
    "robot_width": {
      "kind": "quantity",
      "unit": "m",
      "source": "robot-profile",
      "path": "dimensions.width",
      "text": "The robot's declared width."
    },
    "robot_class": {
      "kind": "category",
      "source": "robot-profile",
      "path": "class",
      "text": "The robot's class, which selects its wall clearance."
    },
    "fall_base_height": {
      "kind": "quantity",
      "unit": "m",
      "source": "configuration-profile",
      "path": "locomotion.fall_base_height",
      "text": "The lowest base height the selected configuration counts as upright."
    }
  },
  "limits": {
    "time_limit": {
      "unit": "s",
      "expression": {
        "op": "add",
        "args": [
          {
            "op": "div",
            "args": [
              {
                "op": "mul",
                "args": [
                  2,
                  {
                    "input": "route_length"
                  }
                ]
              },
              {
                "parameter": "command_speed"
              }
            ]
          },
          5
        ]
      },
      "formula": "2 \u00d7 route_length \u00f7 command_speed + 5 s",
      "round": {
        "decimals": 4,
        "mode": "half-even-binary"
      }
    },
    "lateral_limit": {
      "unit": "m",
      "expression": {
        "op": "sub",
        "args": [
          {
            "op": "div",
            "args": [
              {
                "input": "clear_width"
              },
              2
            ]
          },
          {
            "op": "div",
            "args": [
              {
                "input": "robot_width"
              },
              2
            ]
          }
        ]
      },
      "formula": "clear_width \u00f7 2 \u2212 robot_width \u00f7 2",
      "round": {
        "decimals": 4,
        "mode": "half-even-binary"
      }
    },
    "exit_segment": {
      "unit": "m",
      "expression": {
        "op": "div",
        "args": [
          {
            "input": "clear_width"
          },
          2
        ]
      },
      "formula": "clear_width \u00f7 2, half the exit segment's length",
      "round": {
        "decimals": 4,
        "mode": "half-even-binary"
      }
    },
    "fall_height": {
      "unit": "m",
      "expression": {
        "input": "fall_base_height"
      },
      "formula": "locomotion.fall_base_height"
    }
  },
  "preconditions": {
    "fits_width": {
      "condition": {
        "op": "le",
        "args": [
          {
            "op": "add",
            "args": [
              {
                "input": "robot_width"
              },
              {
                "op": "mul",
                "args": [
                  2,
                  {
                    "parameter": "wall_clearance"
                  }
                ]
              }
            ]
          },
          {
            "input": "clear_width"
          }
        ]
      },
      "formula": "robot_width + 2 \u00d7 wall_clearance \u2264 clear_width",
      "quantize": {
        "decimals": 3,
        "mode": "half-up-decimal-text"
      }
    }
  },
  "checks": [
    {
      "evaluator": "corner-exit-reached",
      "measure": "exit-crossing-time",
      "fail_when": "absent-or-greater-than-limit",
      "limit": "time_limit"
    },
    {
      "evaluator": "corner-turned",
      "measure": "passes-through-places",
      "fail_when": "not-in-order"
    },
    {
      "evaluator": "corner-route-limit",
      "measure": "max-distance-from-route",
      "fail_when": "greater-than-limit",
      "limit": "lateral_limit"
    },
    {
      "evaluator": "corner-wall-contact",
      "measure": "wall-contacts",
      "fail_when": "not-empty"
    },
    {
      "evaluator": "corner-fall",
      "measure": "min-base-height",
      "fail_when": "less-than-limit",
      "limit": "fall_height"
    }
  ]
}
